# Copy to .env and fill in real values. Never commit .env.
# Only variables used by implemented components are listed here.

# Directory containing source annual-report PDFs (default: data/raw)
FGR_RAW_DIR=data/raw
# Directory for extraction outputs (default: data/extracted)
FGR_EXTRACTED_DIR=data/extracted
# Directory for chunking outputs (default: data/processed)
FGR_PROCESSED_DIR=data/processed
# Tokenizer used to size chunks; must match the embedding model's vocabulary
FGR_TOKENIZER=bert-base-uncased
# Local embedding model (free, runs on CPU) and where its index is stored
FGR_EMBED_MODEL=BAAI/bge-small-en-v1.5
FGR_INDEX_DIR=data/index

# Optional: Gemini embeddings (free tier) for comparison - used only with
# --model gemini:gemini-embedding-001. Create a key at
# https://aistudio.google.com/apikey. Sends chunk text to Google.
GEMINI_API_KEY=your-gemini-api-key-here
# Output size (768 / 1536 / 3072), texts per request, pause between requests
FGR_GEMINI_DIM=768
FGR_GEMINI_BATCH=20
FGR_GEMINI_PAUSE_S=2.0

# Knowledge graph: Neo4j AuraDB Free (https://console.neo4j.io) or local Neo4j.
# Copy these from the credentials file AuraDB offers when creating an instance.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j
# Gemini model for risk / executive / competitor extraction (free tier)
FGR_EXTRACT_MODEL=gemini-3.5-flash-lite
FGR_LLM_PAUSE_S=5
# Answer models offered in the web UI (free tier; comma-separated)
FGR_ANSWER_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
