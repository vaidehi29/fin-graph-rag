# Copy to .env and fill in real values. Never commit .env.
# Only variables used by implemented components are listed here.

# Directory containing source annual-report PDFs (default: data/raw)
FGR_RAW_DIR=data/raw
# Directory for extraction outputs (default: data/extracted)
FGR_EXTRACTED_DIR=data/extracted
# Directory for chunking outputs (default: data/processed)
FGR_PROCESSED_DIR=data/processed
