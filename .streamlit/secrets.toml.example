# Streamlit Community Cloud: paste these into the app's Settings -> Secrets.
# Locally you can copy this file to .streamlit/secrets.toml (git-ignored) or keep using .env.
# Keys must be top-level (no [sections]); they are copied into the environment
# by fin_graph_rag.embedders.load_streamlit_secrets(). Placeholder values only.

NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "your-password-here"
NEO4J_DATABASE = "xxxxxxxx"
GEMINI_API_KEY = "your-gemini-api-key"

# Optional (defaults shown)
# FGR_ANSWER_MODELS = "gemini-3.5-flash-lite,gemini-3.5-flash"
# FGR_EXTRACT_MODEL = "gemini-3.5-flash-lite"
